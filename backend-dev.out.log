    SELECT
        s.id,
        s.bank_account,
        s.bank_reference,
        COALESCE(c.booking_date, s.booking_date),
        s.direction,
        s.amount,
        CASE 
            WHEN c.statement_line_id IS NOT NULL 
                THEN 'BOOKED' 
            ELSE s.state 
    END,
    s.description,
    m.transaction_id 
FROM
    bank_statement_lines s 
LEFT JOIN
    bank_statement_matches m 
        ON m.statement_line_id=s.id 
LEFT JOIN
    bank_booking_confirmations c 
        ON c.statement_line_id=s.id 
WHERE
    s.bank_account=? 
    AND COALESCE(c.booking_date, s.booking_date)>=?     
    AND COALESCE(c.booking_date, s.booking_date)<=? 
ORDER BY
    COALESCE(c.booking_date, s.booking_date),
    s.id 
fetch
    first ? rows only 
